---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts.js';

const posts = (await getCollection('gridline', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const cycle = [
  'Unlock Land + Power',
  'Develop Distributed Site Network',
  'Apply AI + Blockchain Automation',
  'Accelerate Speed, Efficiency + Deployment',
  'Monetize Through Leases + Resale',
  'Scale Portfolios + Network Effects',
];

const verticals = ['Logistics', 'Industrial', 'Commercial', 'Retail', 'Hospitality', 'Government'];

const advantages = [
  {
    title: 'Rapid Deployment',
    body: 'Energy and compute sites delivered with streamlined entitlements and modular infrastructure that accelerate time to revenue.',
  },
  {
    title: 'Scalable by Design',
    body: 'A standardized development framework that supports everything from 1–10 MW edge sites to large scale 50 MW plus campuses, adapting to your needs and your growth strategy.',
  },
  {
    title: 'Energy Integrated From Day One',
    body: 'Every site is engineered with built in renewable power options, advanced storage, and grid service capabilities for maximum flexibility and economic performance.',
  },
  {
    title: 'Intelligent Automation',
    body: 'Advanced automation tools speed up site evaluation and development, improve accuracy, and deliver transparency across asset and commercial operations. Our deeper capabilities are available only to partners.',
  },
  {
    title: 'Fully Turnkey Delivery',
    body: 'From permitting and interconnection to construction and commissioning, Forge provides a complete end to end development path so partners can focus on value, not complexity.',
  },
];

const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base>
  <header class="topbar">
    <div class="shell topbar-inner">
      <span class="wordmark">Forge Power</span>
      <a class="btn btn-sm" href={`mailto:${SITE.email}`}>Contact Us</a>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="shell">
        <h1>
          Powering the Next Generation<br /><span class="accent">of Digital Infrastructure</span>
        </h1>
        <p class="hero-sub">
          We transform underutilized land and power into a distributed network of micro-grids and
          edge compute sites, accelerating deployment for partners across logistics, commercial,
          industrial, and public sectors.
        </p>
        <a class="btn" href={`mailto:${SITE.email}`}>Request a partnership consultation</a>
      </div>
    </section>

    <!-- Value proposition -->
    <section class="section surface">
      <div class="shell split">
        <h2>From stranded assets to<br /><span class="accent">digital infrastructure.</span></h2>
        <p class="measure">
          We help partners unlock hidden value inside their real estate portfolios. By converting
          unused land and excess power capacity into modular energy and compute sites, Forge turns
          stranded assets into revenue-ready digital infrastructure.
        </p>
      </div>
    </section>

    <!-- The cycle -->
    <section class="section">
      <div class="shell">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">Networked for security &amp; resilience.</h2>
        <p class="measure">
          A decentralized network of modular micro-grids and compute sites eliminates single points
          of failure, strengthens operational continuity, and ensures data and workloads remain
          secure, local, and sovereign.
        </p>
        <ol class="cycle">
          {
            cycle.map((step, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Verticals -->
    <section class="section surface">
      <div class="shell">
        <p class="eyebrow">Sectors we serve</p>
        <ul class="verticals">
          {verticals.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </section>

    <!-- Advantage -->
    <section class="section">
      <div class="shell">
        <h2 class="section-title">The Forge Advantage, Simplified</h2>
        <p class="measure">
          A platform built to accelerate development, increase reliability, and expand your digital
          infrastructure footprint.
        </p>
        <div class="cards">
          {
            advantages.map((a) => (
              <article class="card">
                <h3>{a.title}</h3>
                <p>{a.body}</p>
              </article>
            ))
          }
        </div>
        <p class="cta-line">
          Interested in deploying energy or compute sites?
          <a href={`mailto:${SITE.email}`}>Contact us</a> for a confidential briefing.
        </p>
      </div>
    </section>

    <!-- The Gridline -->
    <section class="section dark" id="gridline">
      <div class="shell">
        <div class="gridline-head">
          <div>
            <p class="eyebrow eyebrow-invert">Thought leadership</p>
            <h2 class="section-title">The Gridline</h2>
          </div>
          <a class="feed-link" href="/feed.xml">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <circle cx="6.18" cy="17.82" r="2.18" />
              <path
                d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"
              />
            </svg>
            Subscribe via RSS
          </a>
        </div>
        <div class="posts">
          {
            posts.map((post) => {
              const href = post.data.externalUrl ?? `/gridline/${post.id}/`;
              const external = Boolean(post.data.externalUrl);
              return (
                <article class="post">
                  <a
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    <p class="post-meta">
                      <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                      {post.data.featured && <span class="pill">Featured</span>}
                      {external && <span class="pill pill-ghost">LinkedIn</span>}
                    </p>
                    <h3>{post.data.title}</h3>
                    <p class="post-desc">{post.data.description}</p>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell">
      <h2 class="footer-title">Contact Us Today</h2>
      <p class="measure">
        Forge Power. Built by industry veterans in energy, AI, and digital infrastructure.
      </p>
      <p>
        For partnerships, investment, and media inquiries, contact us:<br />
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p class="legal">
        © {new Date().getFullYear()} Forge Power. All rights reserved.<br />
        <!-- TODO: restore the five legal pages from the Canva site. -->
        <a href="/legal/privacy/">Privacy Policy</a> ·
        <a href="/legal/terms/">Terms of Service</a> ·
        <a href="/legal/cookies/">Cookie Policy</a> ·
        <a href="/legal/accessibility/">Accessibility Statement</a> ·
        <a href="/legal/disclaimers/">Disclaimers</a> ·
        <a href="/feed.xml">RSS</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
  }
  .wordmark {
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .btn {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    border: 2px solid var(--ink);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn:hover {
    background: var(--green);
    color: var(--ink);
    border-color: var(--green);
  }
  .btn-sm {
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
  }

  .hero {
    padding-block: clamp(4rem, 12vw, 9rem);
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgba(0, 255, 21, 0.16), transparent 65%),
      var(--ground);
  }
  .hero h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .hero-sub {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 58ch;
    margin-block: 1.75rem 2.25rem;
  }

  .surface {
    background: var(--surface);
  }
  .measure {
    max-width: var(--measure);
  }
  .section-title {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    grid-template-columns: 1fr;
  }
  .split h2 {
    font-size: var(--step-3);
  }
  @media (min-width: 55rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .cycle {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .cycle li {
    background: var(--ground);
    padding: 1.75rem 1.5rem;
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    font-weight: 500;
  }
  .num {
    color: var(--green-deep);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .verticals {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .verticals li {
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.55rem 1.25rem;
    font-weight: 700;
    font-size: var(--step--1);
  }

  .cards {
    margin-top: 3rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .card {
    border: 1px solid var(--rule);
    border-top: 4px solid var(--green);
    border-radius: 6px;
    padding: 1.75rem 1.5rem;
  }
  .card h3 {
    font-size: var(--step-1);
    margin-bottom: 0.75rem;
  }
  .card p {
    color: var(--ink-soft);
    font-size: var(--step--1);
    margin: 0;
  }
  .cta-line {
    margin-top: 2.5rem;
    font-size: var(--step-1);
    font-weight: 500;
  }
  .cta-line a {
    color: var(--green-deep);
  }

  .dark {
    background: var(--ink);
    color: #fff;
  }
  .eyebrow-invert {
    color: rgba(255, 255, 255, 0.6);
  }
  .gridline-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--green);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--step--1);
    border: 1px solid rgba(0, 255, 21, 0.4);
    border-radius: 999px;
    padding: 0.5rem 1rem;
  }
  .feed-link:hover {
    background: rgba(0, 255, 21, 0.1);
  }

  .posts {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.15);
    border-block: 1px solid rgba(255, 255, 255, 0.15);
  }
  .post a {
    display: block;
    background: var(--ink);
    padding: 2rem 0;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .post a:hover {
    background: #1d1f1b;
  }
  .post h3 {
    font-size: var(--step-2);
    max-width: 30ch;
    margin-bottom: 0.6rem;
  }
  .post-desc {
    color: rgba(255, 255, 255, 0.66);
    max-width: 62ch;
    margin: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.75rem;
  }
  .pill {
    background: var(--green);
    color: var(--ink);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .pill-ghost {
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .footer {
    background: var(--surface);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .footer-title {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .mail {
    color: var(--green-deep);
    font-weight: 700;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .legal a {
    color: var(--ink-soft);
  }
</style>
