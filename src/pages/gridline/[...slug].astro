---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  // External (LinkedIn) entries get no local page — they live on LinkedIn.
  const posts = await getCollection(
    'gridline',
    ({ data }) => !data.draft && !data.externalUrl
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <main id="main" class="section">
    <article class="shell article">
      <p class="eyebrow">The Gridline</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatted}</time>
      </p>
      <div class="body">
        <Content />
      </div>
      <p class="back"><a href="/#gridline">← All Gridline posts</a></p>
    </article>
  </main>
</Base>

<style>
  .article {
    max-width: var(--measure);
  }
  h1 {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }
  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .meta {
    font-size: var(--step--1);
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .body :global(h2) {
    font-size: var(--step-2);
    margin: 2.5rem 0 1rem;
  }
  .body :global(a) {
    color: var(--green-deep);
  }
  .back {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-weight: 500;
  }
  .back a {
    text-decoration: none;
  }
  .back a:hover {
    text-decoration: underline;
  }
</style>
